{
  "$schema": "https://docs.renovatebot.com/renovate-schema.json",
  "extends": [
    "config:recommended"
  ],
  "semanticCommits": "enabled",
  "customManagers": [
    {
      "customType": "regex",
      "description": "Update Proton Bridge version",
      "managerFilePatterns": [
        "/^VERSION$/"
      ],
      "matchStrings": [
        "^(?<currentValue>v\\d+\\.\\d+\\.\\d+)$"
      ],
      "depNameTemplate": "ProtonMail/proton-bridge",
      "packageNameTemplate": "ProtonMail/proton-bridge",
      "datasourceTemplate": "github-releases",
      "versioningTemplate": "semver-coerced"
    }
  ],
  "packageRules": [
    {
      "description": "Automerge Proton Bridge releases after checks pass",
      "matchPackageNames": [
        "ProtonMail/proton-bridge"
      ],
      "automerge": true,
      "automergeType": "pr",
      "platformAutomerge": false,
      "minimumReleaseAge": "3 days"
    }
  ]
}
